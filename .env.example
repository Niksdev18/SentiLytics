# Senti-Lytics Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These override the corresponding values in config.yaml.

# NewsAPI key (required for live news fetching)
# Get yours at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Path to the fine-tuned transformer model
# Default: models/transformer_model/best_model
# MODEL_PATH=models/transformer_model/best_model

# Set to "true" to run with synthetic demo data (no API keys needed)
# DEMO_MODE=false

# Flask settings
# FLASK_ENV=development
# FLASK_DEBUG=false
# FLASK_PORT=5000
