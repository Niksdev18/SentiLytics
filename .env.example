# Senti-Lytics Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These override the corresponding values in config.yaml.

# TinyFish API key (recommended for live web search and agent automation)
# Get yours at https://agent.tinyfish.ai
TINYFISH_API_KEY=sk-tinyfish-your_actual_key_here

# News Provider: tinyfish, newsapi, or auto (default: auto)
NEWS_PROVIDER=tinyfish

# NewsAPI key (alternative / fallback news provider)
# Get yours at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Path to the fine-tuned transformer model
# Default: models/transformer_model/best_model
# MODEL_PATH=models/transformer_model/best_model

# Set to "true" to run with synthetic demo data (no API keys needed)
# DEMO_MODE=false

# Flask settings
# FLASK_ENV=development
# FLASK_DEBUG=false
# FLASK_PORT=5000
